{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}
<header class="store-header tk-header">
  {# Top bar: contacts, important pages, language/currency, branches #}
  <div class="top-navbar tk-topbar">
    <div class="container flex items-center justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
          <salla-contacts is-header class="tk-topbar__contacts"></salla-contacts>
      </div>

      <div class="flex items-center gap-2 shrink-0">
          {% if important_links %}
            <salla-menu source="footer" topnav class="hidden lg:block"></salla-menu>
          {% endif %}

          {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
              <div class="header-buttons">
                  <salla-localization-modal show-trigger></salla-localization-modal>
              </div>
          {% endif %}

          {% if store.scope %}
              <button type="button" class="btn--rounded-gray"
                      onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
                  <i class="sicon-location rtl:ml-1 ltr:mr-1" aria-hidden="true"></i> {{ store.scope.name }}
              </button>
          {% endif %}
      </div>
    </div>
  </div>

  {# Main nav: logo · menu · search · account · WhatsApp #}
  <div id="mainnav" class="main-nav-container tk-mainnav flex items-center">
      <div class="inner bg-inherit w-full">
          <div class="container">
              <div class="tk-mainnav__row">
                  <div class="flex items-center min-w-0">
                      <a class="lg:hidden mburger mburger--collapse tk-icon-btn rtl:ml-2 ltr:mr-2" href="#mobile-menu" aria-label="فتح القائمة">
                        <i class="sicon-menu" aria-hidden="true"></i>
                      </a>
                      <a class="navbar-brand tk-brand" href="{{ store.url }}" aria-label="{{ store.name }} — الصفحة الرئيسية">
                          <img fetchpriority="high" width="160" height="56" loading="eager" src="{{ store.logo|cdn(240) }}" alt="{{ store.name }}">
                          {% if is_page('index') %}
                            <h1 class="sr-only">{{ store.name }}</h1>
                          {% endif %}
                      </a>
                      <custom-main-menu class="tk-main-menu"></custom-main-menu>
                  </div>

                  <div class="flex items-center justify-end gap-2 sm:gap-3 shrink-0">
                      <button type="button" class="tk-icon-btn" aria-label="البحث في المتجر"
                              onclick="salla.event.dispatch('search::open')">
                          <i class="sicon-search" aria-hidden="true"></i>
                      </button>
                      <salla-user-menu avatar-only show-header show-trigger class="tk-user-menu"></salla-user-menu>
                      {% include 'pages.partials.tamkeen.wa-button' with {
                          wa_label: 'اطلب عبر واتساب',
                          wa_class: 'tk-btn--sm tk-header-wa'
                      } %}
                  </div>
              </div>
          </div>
      </div>
  </div>
</header>
