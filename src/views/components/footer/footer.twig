<footer class="store-footer tk-footer">
	{# WhatsApp call-to-action band #}
	<div class="tk-footer__cta">
		<div class="container tk-footer__cta-inner">
			<div>
				<p class="tk-footer__cta-title">هل تحتاج مساعدة في اختيار الحل المناسب؟</p>
				<p class="tk-footer__cta-text">تواصل معنا عبر واتساب وسنساعدك في الطلب أو الاستفسار.</p>
			</div>
			{% include 'pages.partials.tamkeen.wa-button' with { wa_label: 'تحدث معنا عبر واتساب', wa_class: 'tk-btn--lg' } %}
		</div>
	</div>

	<div aria-label="تذييل الموقع" class="store-footer__inner tk-footer__inner">
		<div class="container tk-footer__grid">
			<div class="tk-footer__about">
				<a href="{{ link('/') }}" class="tk-footer__brand" aria-label="{{ store.name }}">
					<img src="{{ store.logo|cdn(240) }}" alt="{{ store.name }}" width="160" height="56" loading="lazy">
				</a>
				{% if store.description %}
					<div class="tk-footer__desc">
						{{ store.description|raw }}
					</div>
				{% endif %}
				<salla-social class="tk-footer__social"></salla-social>
			</div>

			<nav aria-label="روابط مهمة">
				<h3 class="tk-footer__heading">روابط مهمة</h3>
				<salla-menu source="footer" with-cookie-preferences></salla-menu>
			</nav>

			<div>
				<h3 class="tk-footer__heading">تواصل معنا</h3>
				<salla-contacts></salla-contacts>
			</div>

			<div class="tk-footer__trust">
				<salla-trust-badges dark></salla-trust-badges>
				{% if store.settings.tax.number %}
					<div class="flex rtl:space-x-reverse space-x-2 items-end mt-4">
						{% if store.settings.tax.certificate %}
							<a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" aria-label="شهادة الرقم الضريبي">
								<img width="40" height="50" src="{{'images/tax.png' | cdn(70,70)}}" loading="lazy" class="w-10 rounded-sm hover:opacity-80 transition-opacity" alt="شهادة ضريبة القيمة المضافة">
							</a>
						{% endif %}
						<div>
							<p class="text-sm opacity-80 mb-1">{{ trans('common.elements.tax_number') }}</p>
							<b class="text-sm">{{ store.settings.tax.number }}</b>
						</div>
					</div>

					{% if store.settings.tax.certificate %}
						<salla-modal sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
							<div class="flex justify-center max-w-full">
								<img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
							</div>
						</salla-modal>
					{% endif %}
				{% endif %}
				<salla-apps-icons class="block mt-4"></salla-apps-icons>
			</div>
		</div>
	</div>

	<div class="tk-footer__bottom">
		<div class="container md:flex items-center justify-between gap-4 py-4 text-center">
			<span class="text-sm copyright-text">{% hook copyright %}</span>
			<salla-payments></salla-payments>
		</div>
	</div>
</footer>
